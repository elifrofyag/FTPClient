<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ann.ftp.gui.Controller">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label text="HOST" />
            <TextField fx:id="txtHost" text="127.0.0.1" />
            <Label text="PORT" />
            <TextField fx:id="txtPort" prefWidth="50.0" text="21" />
            <Label text="USER" />
            <TextField fx:id="txtUser" text="" />
            <Label text="PASS" />
            <PasswordField fx:id="txtPass" text="" />
            <Button fx:id="btnConnect" mnemonicParsing="false" onAction="#handleConnect" text="CONNECT" />
            <Button maxWidth="1.8E3" mnemonicParsing="false" onAction="#handleDisconnect" text="DISCONNECT" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="120.0" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Button maxWidth="1.8E3" mnemonicParsing="false" onAction="#handleDownload" text="Download" />
            <Button maxWidth="1.8E3" mnemonicParsing="false" onAction="#handleUpload" text="Upload" />
            <Button maxWidth="1.8E3" mnemonicParsing="false" onAction="#handleDelete" text="Delete File" />
            <Button maxWidth="1.8E3" mnemonicParsing="false" onAction="#handleMkdir" text="MKDir" />
            <Button maxWidth="1.8E3" mnemonicParsing="false" onAction="#handleRmdir" text="RMDir" />
         <AnchorPane prefHeight="42.0" prefWidth="100.0">
            <children>
                  <Button layoutX="22.0" layoutY="174.0" maxWidth="1.8E3" mnemonicParsing="false" onAction="#handleRefresh" text="Refresh" />
            </children>
         </AnchorPane>
        </VBox>
    </left>

    <center>
        <SplitPane dividerPositions="0.5" BorderPane.alignment="CENTER">
            <VBox spacing="5.0">
                <BorderPane>
                    <left>
                        <Label text="Local" BorderPane.alignment="CENTER" />
                    </left>
                    <right>
                        <Label fx:id="lblLocalPath" text="C:\" BorderPane.alignment="CENTER" />
                    </right>
                </BorderPane>
                <ListView fx:id="listLocal" VBox.vgrow="ALWAYS" />
            </VBox>

            <VBox spacing="5.0">
                <BorderPane>
                    <left>
                        <Label text="Remote Server" BorderPane.alignment="CENTER" />
                    </left>
                    <right>
                        <Label fx:id="lblRemotePath" text="/" BorderPane.alignment="CENTER" />
                    </right>
                </BorderPane>
                <ListView fx:id="listRemote" VBox.vgrow="ALWAYS" />
            </VBox>
        </SplitPane>
    </center>

    <bottom>
        <VBox spacing="5.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label text="SYSTEM LOG CONSOLE" />
            <TextArea fx:id="txtLog" editable="false" prefHeight="150.0" />
        </VBox>
    </bottom>

</BorderPane>
