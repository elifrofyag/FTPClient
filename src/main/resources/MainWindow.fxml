<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ann.ftp.gui.Controller">
    <top>
        <HBox alignment="CENTER_LEFT" layoutX="118.0" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label text="HOST" />
            <TextField fx:id="txtHost" text="127.0.0.1" />
            <Label text="PORT" />
            <TextField fx:id="txtPort" prefWidth="50.0" text="21" />
            <Label text="USER" />
            <TextField fx:id="txtUser" text="" />
            <Label text="PASS" />
            <PasswordField fx:id="txtPass" text="" />
            <Button fx:id="btnConnect" mnemonicParsing="false" onAction="#handleConnect" text="CONNECT" />
            <Button fx:id="btnDisconnect" maxWidth="1.8E3" mnemonicParsing="false" onAction="#handleDisconnect" text="DISCONNECT" />
        </HBox>

    </top>

    <left>
        <VBox prefWidth="120.0" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="30.0" />
            </padding>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDownload" styleClass="button-secondary" text="Download" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleUpload" styleClass="button-secondary" text="Upload" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDelete" styleClass="button-secondary" text="Delete File" />
         <Separator prefWidth="200.0" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleMkdir" styleClass="button-secondary" text="Make Dir" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRmdir" styleClass="button-secondary" text="Remove Dir" />
         <Separator prefWidth="200.0" />
            <Button maxWidth="1.8E3" mnemonicParsing="false" onAction="#handleRefresh" prefHeight="25.0" prefWidth="99.0" styleClass="button-secondary" text="Refresh" />
        </VBox>
    </left>

    <center>
        <SplitPane styleClass="split-pane" dividerPositions="0.5" BorderPane.alignment="CENTER">
            <VBox spacing="5.0">
                <BorderPane>
                    <left>
                        <Label text="Local" BorderPane.alignment="CENTER" />
                    </left>
                    <center>
                        <Label fx:id="lblLocalPath" text="C:\" BorderPane.alignment="CENTER" />
                    </center>
                </BorderPane>
                <ListView fx:id="listLocal" VBox.vgrow="ALWAYS" />
            </VBox>

            <VBox spacing="5.0">
                <BorderPane>
                    <left>
                        <Label text="Remote Server" BorderPane.alignment="CENTER" />
                    </left>
                    <center>
                        <Label fx:id="lblRemotePath" text="/" BorderPane.alignment="CENTER" />
                    </center>
                </BorderPane>
                <TableView fx:id="tableRemote" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colName" prefWidth="92.0" text="NAME" />
                        <TableColumn fx:id="colSize" prefWidth="156.0" text="SIZE" />
                        <TableColumn fx:id="colDate" prefWidth="202.0" text="MODIFIED" />
                        <TableColumn fx:id="colPerms" prefWidth="100.0" text="PERMISSION" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </SplitPane>
    </center>

    <bottom>
        <VBox spacing="5.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label text="SYSTEM LOG CONSOLE" />
            <ListView fx:id="txtLog" prefHeight="150.0" styleClass="log-list" />
        </VBox>
    </bottom>

</BorderPane>
